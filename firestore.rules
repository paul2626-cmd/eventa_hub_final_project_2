rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if request.auth != null;
      // Register/cancel only touches the counter, one step at a time.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
                    && (request.resource.data.registeredCount == resource.data.registeredCount + 1
                        || request.resource.data.registeredCount == resource.data.registeredCount - 1);
      allow create, delete: if false; // organizers/admin only (out of scope)
    }

    match /registrations/{regId} {
      allow read: if request.auth != null
                  && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && regId == request.auth.uid + "_" + request.resource.data.eventId;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if false; // soft delete only
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // One document per student number so it can only be claimed once.
    match /studentNumbers/{studentNumber} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
